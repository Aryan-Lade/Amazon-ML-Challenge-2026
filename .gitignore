# Cache folder: ignore large pickle files but keep trained model artifacts
.cache/*
**/.cache/*
!.cache/model/
!**/.cache/model/
!**/.cache/model/**

# Large pickle files
*.pkl
*.pickle
*.bin
*.pt
*.pth
*.onnx

# Allow lightweight trained model files
!**/.cache/model/lgbm_model.pkl
!**/.cache/model/config.json
